[meta]
name = "Sturgis implementation workflow"
active_feature = "sturgis-03"
source_of_truth = "spec/sturgis-03/spec.kvx"

[mode]
name = "parallel"

[limits]
max_in_progress = 4

[agents]
max = 4
driver = "codex"
ttl = 120

[principle]
task_driven = "Claim dependency-ready work in the declared file lane. Root alone edits shared manifests and spec state."
verified_done = "Focused tests and graph checks precede done. Final qualification enforces separate Python, C++ and authored TypeScript/JavaScript 90 percent line coverage."

[loop]
step_1 = "Read the active spec and contracts; inspect only current relevant source."
step_2 = "Root claims ready tasks with explicit owner and dependencies; one active task per agent."
step_3 = "Implement only declared paths and publish interface changes before dependent work."
step_4 = "Run focused verification; root reconciles integration and completes tasks through cg spec done."
step_5 = "Run the aggregate coverage/recovery/scope gate once after integration; retain truthful evidence."
step_6 = "Maintain both documentation sites: complete user manuals/examples and developer architecture, file/function contracts, important source branches and operating guides."
step_7 = "Run python3 scripts/docs_gate.py full. Both site builds, independent feature/source completeness, rendered links, examples and browser journeys must pass before cg docs close."

[documentation]
user_site = "documentation/users"
developer_site = "documentation/developers"
verify_cmd = "python3 scripts/docs_gate.py full"
completeness = "Every feature must have user guidance and examples; every first-party file and symbol must have source-grounded developer reference with important behavior explained. Generated lists alone do not qualify."

[hard_rules]
active_scope = "Sturgis-03 adds an independent model gateway and consumer client integration; preserve completed core/consumer work and historical evidence. No paid/public deployment is authorized."
no_false_done = "Source presence and coverage alone are not runtime qualification; record exact executed evidence."
coverage = "Never lower 90 percent Python, C++ and client JavaScript line coverage gates or omit first-party production files to pass."
preserve_work = "Exclusive module/test ownership; do not overwrite another agent's files or modify prior research."

[render]
markdown_mirror = true
banner = "GENERATED by cg spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"
