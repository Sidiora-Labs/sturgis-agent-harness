requires = ["1.1", "2.2", "3.3"]
reqs = ["8.1", "8.2", "8.3"]
touches = ["agent/runtime/**", "agent/acp/**", "agent/provider_adapters/**", "agent/state/**", "agent/channel_core/**", "agent/tool_runner/__init__.py", "tests/core/test_runtime.py", "tests/core/test_qualification_gate.py", "scripts/qualify.py", "tests/integration/**", "docs/**", "README.md"]
verify_cmd = ".venv/bin/python -m pytest tests/core/test_runtime.py tests/integration -q"
