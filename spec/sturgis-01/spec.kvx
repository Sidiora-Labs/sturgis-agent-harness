do_2 = "Prove steering during blocked tools, durable input/output, fixed provider snapshots, cancellation and restart without duplicate effects."

[task.5.1]
title = "Full coverage, recovery, contract and scope qualification"
status = "done"
wave = 5
owner_lane = "root-qualification"
requires = ["1.2", "2.1", "2.2", "2.3", "2.4", "3.1", "3.2", "4.1"]
reqs = ["1.1", "1.2", "2.1", "2.2", "3.1", "3.2", "4.1", "4.2", "4.3", "5.1", "5.2", "6.1", "6.2", "7.1", "7.2", "7.3", "8.1", "8.2", "8.3", "9.1", "9.2", "10.1", "10.2", "10.3", "10.4"]
