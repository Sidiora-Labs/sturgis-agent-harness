reqs = ["1.1", "13.1", "13.2"]
touches = ["consumer/__init__.py", "consumer/contracts.py", "consumer/config.py", "pyproject.toml", "package.json", "scripts/qualify_consumer.py", "scripts/verify_native.py", "scripts/verify_web.mjs", "tests/consumer/test_contracts.py", "tests/consumer/test_consumer_gate.py", ".gitignore", ".cgignore"]
