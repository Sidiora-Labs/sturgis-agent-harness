# sturgis-02: consumer product and portable hosting. Executable source of truth.
[meta]
feature = "sturgis-02"
title = "Sturgis 02 — Consumer features and portable hosting"
status = "in_progress"
spec_version = "1.1.0"
intro = "Build one Python consumer product for self-hosted and hosted operation, with responsive web and CLI, private runtime continuity, parallel task lanes and independent 90 percent coverage."

[design]
overview = "Existing core authority with authenticated consumer commands, private runtime lifecycle, usable clients and source-backed capability breadth."
include = "design.body.md"

[documentation]
mode = "manual"
status = "done"
audiences = ["user", "developer", "operator"]
targets = ["README.md", "docs/core.md", "docs/qualification.md", "docs/sturgis-02/consumer.md", "docs/sturgis-02/deployment.md", "docs/sturgis-02/qualification.md", "native/memory/PROTOCOL.md", "agent/memory/README.md", "agent/scheduler/README.md", "agent/tool_runner/README.md", "agent/self_evolution/README.md", "packaging/README.md", "frontend/licenses/README.md", "spec/sturgis-02/contracts.md", "spec/sturgis-02/http-contract.md", "spec/sturgis-02/coverage.md", "spec/sturgis-02/execution.md", "spec/sturgis-02/feature-map.md", "spec/sturgis-02/design.body.md", "documentation/README.md", "documentation/users/src/content/docs/**", "documentation/developers/src/content/docs/**", "documentation/closure.md"]

# Reopened by the owner scope correction: Markdown summaries do not satisfy two complete documentation sites.
user_site = "documentation/users"
developer_site = "documentation/developers"
full_gate = "python3 scripts/docs_gate.py full"

[req.1]
title = "Consumer product and two modes"
story = "As a Sturgis owner, I need consumer product and two modes."
ac_1 = "Implement responsive web and CLI clients over the same authenticated Python consumer contract for self_hosted and hosted operation. Existing agent/native mechanisms retain authority."
ac_2 = "Classify every audited family in feature-map.md; implement stated first-pass adapters and explicitly label unsupported providers/devices. No paid deployment or proprietary control-plane dependency is required."

[req.2]
title = "Identity and private ownership"
story = "As a Sturgis owner, I need identity and private ownership."
ac_1 = "Secure first-owner bootstrap, password hashing, opaque sessions with revocation/expiry, CSRF/origin protection and owner-to-agent authorization persist across restart."
ac_2 = "Cross-account access to agent commands, events, artifacts, credentials and lifecycle operations is rejected before private worker access; caller-selected scopes/roots cannot confer authority."

[req.3]
title = "Credentials and provider readiness"
story = "As a Sturgis owner, I need credentials and provider readiness."
ac_1 = "Use authenticated encryption with private key/file permissions outside writable workspaces; public configuration, journals, errors and tokens do not expose secrets."
ac_2 = "Provider configuration and credential revisions invalidate observations; readiness requires an actual bounded provider request, and execution uses the selected current credential without journal leakage."

[req.4]
title = "Conversations and continuous I/O"
story = "As a Sturgis owner, I need conversations and continuous i/o."
ac_1 = "Durably retain stable-id messages before waking private workers; preserve conversation metadata, history/search, streamed output, replay cursors and separate accepted/delivered/completed states."
ac_2 = "Steering/cancellation during slow inference/tools remains responsive. Recovery preserves accepted input, output and indeterminate effects without duplicate effective actions."

[req.5]
title = "Content knowledge and memory"
story = "As a Sturgis owner, I need content knowledge and memory."
ac_1 = "Support bounded typed uploads, scoped artifact read/download, rooted file operations with preimage/revision guards, source-backed text knowledge/search and explicit unsupported formats."
ac_2 = "Memory search/correction/retraction uses the real native engine; exact source evidence and labels distinguish uploaded documents, user input and retrieved memory. Attachments reach model context or an explicit bounded deferral."

[req.6]
title = "Work automation and attention"
story = "As a Sturgis owner, I need work automation and attention."
ac_1 = "Expose goals, commitments, plan/workflow dependencies, child results, schedules, initiative/inbox and operational evidence through consumer commands/views."
ac_2 = "Schedules and workflow execution use core owners and grants; daily memory consolidation and compute suspension remain distinct. User-facing success cannot be manufactured from model narrative."

[req.7]
title = "Permissions and usage"
story = "As a Sturgis owner, I need permissions and usage."
ac_1 = "Persist revisioned policy and bounded human approvals tied to actual capability/action versions. Revocation fences new execution and reports pending versus effective state."
ac_2 = "Expose deduplicated actual consumption, recorded overages and unresolved reservations; estimates/entitlements remain separate from payment settlement and cannot erase factual receipts."

[req.8]
title = "Connections and external ingress"
story = "As a Sturgis owner, I need connections and external ingress."
ac_1 = "Implement versioned configure/probe/grant/revoke lifecycle with scoped credential references and current-revision execution checks."
ac_2 = "Signed webhooks verify sender/timestamp/nonce/body and durably deduplicate before attributed admission. External payloads cannot select owner identity or bypass scheduler grants."

[req.9]
title = "Concrete browser media and protocol adapters"
story = "As a Sturgis owner, I need concrete browser media and protocol adapters."
ac_1 = "Implement bounded HTTP fetch/search, HTTP MCP schema negotiation/execution, real CDP browser operations, configured HTTP speech/image providers and a paired remote-device protocol."
ac_2 = "Network policy enforces allowed destinations and redirects, scope, time/byte/resource bounds and operator-only private-origin exceptions. Unsupported delegation/device/OS/vendor capabilities fail explicitly."

[req.10]
title = "Private runtime lifecycle"
story = "As a Sturgis owner, I need private runtime lifecycle."
ac_1 = "Implement common authenticated bounded worker IPC, fixed runtime scope/root, durable lifecycle operations, readiness, restart/recovery and a real hosted Linux namespace backend."
ac_2 = "Hosted worker filesystem/PID/resource containment is exercised; network sharing and capability egress policy are stated accurately. Self-host trusted-local process mode is not presented as hosted isolation proof."
ac_3 = "Accepted input and due work survive wake/suspend/replacement; single-owner fencing, live-work checks, storage consistency and uncertain command outcomes constrain retries."

[req.11]
title = "Portability and installation"
story = "As a Sturgis owner, I need portability and installation."
ac_1 = "Implement versioned consistent backup/export and bounded restore with hashes, traversal/symlink checks, target ownership and explicit root relocation. Exclude/reconnect credentials and execution authority."
ac_2 = "Package Python CLI, web assets, native worker and service/container examples; exercise installed entry points and private runtime startup. Self-host installation works without vendor accounts."

[req.12]
title = "Usable consumer client"
story = "As a Sturgis owner, I need usable consumer client."
ac_1 = "Build conversation-first responsive web with persistent composer, agent/conversation navigation and Work/Knowledge/Files/Connections/Settings views plus clear readiness/error/recovery states."
ac_2 = "CLI uses the same authenticated API for setup/serve/login/agents/chat/events/stop and domain/backup/doctor operations; no second inference loop."
ac_3 = "Real browser journeys exercise core interactions, keyboard/narrow layouts and safe rendering of untrusted text/artifacts."
ac_4 = "The self-hosted client uses Gemini-inspired Material 3 styling with Sturgis branding and a premium React/TypeScript application with Vite, accessible Radix components, Tailwind design tokens, locally served typography, reduced-motion-aware transitions, cached scoped data, deliberate loading states and measured interaction/bundle performance. Source is divided into shell, components, data hooks and feature pages."

[req.13]
title = "Parallel execution and qualification"
story = "As a Sturgis owner, I need parallel execution and qualification."
ac_1 = "Use disjoint task ownership and dependency joins with up to four agents; focused verification and tagged snapshots precede done."
ac_2 = "Enforce independent 90 percent executable line coverage for complete Python agent/consumer, production C++ and all production client JavaScript. Report branches and validate complete denominators and source hashes."
ac_3 = "Qualify actual databases/workers/native memory/effects/browser plus controlled remote wire endpoints; no source-only or fixture-only production claims."

[req.14]
title = "Complete user and developer documentation sites"
story = "As a user or developer, I need an independently usable documentation site that teaches the entire system and documents every feature and important implementation contract."
ac_1 = "Produce two separate searchable, responsive static sites with Sturgis branding, accessible navigation, light/dark themes, code examples, learning paths and complete cross-linked guides. A Markdown guide, source list or passing link ledger alone cannot satisfy this requirement."
ac_2 = "User manuals cover every consumer feature, actual UI/CLI/API exposure, prerequisites, step-by-step examples, expected outcomes, errors, recovery and self-hosted/hosted limits. Inventory live command, configuration and feature families independently of the prose."
ac_3 = "Developer manuals cover all module responsibilities, architecture, protocols, data ownership, control and failure paths, extension contracts, frontend, installation, operation, testing and maintenance with working examples and source anchors."
ac_4 = "Generate and audit complete first-party file and qualified-symbol references from actual source, including signatures, defaults, annotations, exceptions, call sites, effects and important control branches. Every source line remains reachable. Generated syntax facts complement authored explanations and never masquerade as behavioral qualification."
ac_5 = "The full docs gate must build both sites, reject missing or stale source/feature coverage, verify every rendered local link and anchor, exercise real search/navigation/mobile/theme/code-copy journeys, validate representative examples, and retain source-bound evidence before documentation closure. Product coverage floors remain unchanged."

