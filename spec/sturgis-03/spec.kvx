[meta]
feature = "sturgis-03"
title = "Sturgis 03 — Independent model gateway"
status = "in_progress"
spec_version = "1.0.0"
intro = "Replace agent-owned provider setup with an independent, standalone model gateway inspired by an examined and pinned 9router architecture. Agents and other applications consume its standard inference endpoint."

[design]
overview = "Gateway-owned connections, encrypted credentials, catalogs, client keys, routing, cooldowns and usage; consumer-owned authentication integration; agents retain only a gateway client credential and model selection."
include = "design.body.md"

[documentation]
mode = "manual"
status = "pending"
audiences = ["user", "developer", "operator"]
targets = ["README.md", "spec/sturgis-03/**", "documentation/README.md", "documentation/closure.md", "documentation/users/src/content/docs/**", "documentation/developers/src/content/docs/**", "docs/sturgis-03/**", "model_gateway/README.md"]
user_site = "documentation/users"
developer_site = "documentation/developers"
full_gate = "python3 scripts/docs_gate.py full"
qualification_receipt = "evidence/sturgis-docs/qualification.json"
runtime_qualification_receipt = "evidence/sturgis-03/qualification.json"
live_verification = "evidence/sturgis-03/live.json"
live_openrouter_chat = "evidence/sturgis-03/openrouter-live.json"
live_openrouter_tools = "evidence/sturgis-03/openrouter-live-tools.json"
live_agent_identity = "evidence/sturgis-03/identity-live.json"
live_conversation_history = "evidence/sturgis-03/history-live.json"
qualified_user_pages = 45
qualified_developer_pages = 347
qualified_source_reference_files = 288
qualified_source_lines = 62632
qualified_source_symbols = 4254

[req.1]
title = "Independent subsystem and source-grounded reference"
story = "As an operator, I can use the model gateway without creating or running an agent."
ac_1 = "Inspect pinned 9router source, document actual persistence/authentication/executor/translator/routing boundaries and license; separate supported formats from provider-specific sign-in flows."
ac_2 = "model_gateway imports neither agent nor consumer; owns durable state, encryption, API keys, routing and usage; runs through its own CLI/ASGI app or composition mount."

[req.2]
title = "Provider connections and current catalogs"
story = "As a self-hosted user, I connect a preset or custom provider in one drawer."
ac_1 = "Preset provider name and endpoint, inline encrypted API key, bounded live model discovery/import and optional custom model IDs replace credential references, required token-limit fields and manual probe/activate steps."
ac_2 = "Include source-backed free/no-auth, free-tier, local, paid and compatible gateway presets; label account quotas and specialized authentication honestly; support custom endpoints for implemented wire formats."
ac_3 = "Connections support multiple accounts, optimistic revisions, refresh, update and disconnect; secrets never enter frontend persistence, public responses, logs or usage records."

[req.3]
title = "Inference gateway and routing"
story = "As any model client, I connect once and use imported models or named routes."
ac_1 = "Authenticated OpenAI-compatible models and chat completions work in streaming and nonstreaming modes; upstream OpenAI Chat, Responses, Anthropic and Gemini translation supports arbitrary function names, usage, cancellation and honest terminal states."
ac_2 = "Named priority and round-robin routes provide bounded fallback before output, retryable-failure cooldowns and usage for each attempt; no retry after visible output and no invented usage."
ac_3 = "Client keys are hashed, revocable and model-scoped; tenant authority is server-derived; network destinations and local-server exceptions remain bounded and isolated from agent tool policy."

[req.4]
title = "Independent premium management and agent client"
story = "As a user, I manage model infrastructure separately and select a gateway model for my agent."
ac_1 = "Material 3 Model Gateway navigation works before an agent exists and while agent runtimes are stopped, with provider search, connection drawer, model import, routes, keys and usage."
ac_2 = "Agent settings choose a gateway model through one action; only a restricted gateway credential reaches its runtime; upstream provider keys remain gateway-owned. Existing configurations and user data survive migration."
ac_3 = "Exercise real browser setup, model import, key creation and agent model binding against controlled wire servers; rebuild and restart the authorized local service after qualification."

[req.5]
title = "Documentation and qualification"
story = "As a user or developer, I can learn and operate every gateway feature with examples."
ac_1 = "Both documentation sites include gateway setup, free-tier limits, local/custom providers, model discovery, keys, routes, troubleshooting, standalone operation, architecture, all source references and boundaries."
ac_2 = "Preserve full Python/C++/client 90 percent executable-line floors; include model_gateway in production and documentation inventories, run full documentation gate, and report live vendor qualification separately from controlled wire proof."

[req.6]
title = "Complete native account lifecycle and client protocols"
story = "As a gateway user, I sign in to supported provider accounts and use native model clients without configuring an agent."
ac_1 = "Implement native GitHub Copilot and Kiro device flows plus Codex and Gemini CLI PKCE, tenant-bound expiring sessions, cancellation, encrypted token bundles, account discovery, provider-specific inference and durable refresh fencing. No third-party gateway installation substitutes for these paths."
ac_2 = "Standalone administration includes its own authenticated UI, management sessions, settings, export/import recovery and client-key lifecycle; provider entitlements and actual remote sign-in qualification remain explicit."
ac_3 = "Expose OpenAI Chat, Responses and Anthropic Messages client APIs. Preserve native signed/opaque state for matching protocols and reject unsupported lossy cross-format transformations explicitly. Exercise streams, nonstream collection, failure after output, request cancellation and account restart paths."

