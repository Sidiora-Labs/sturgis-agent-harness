{
  "name": "sturgis-documentation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:users": "astro dev --root users --port 4321 --host 127.0.0.1",
    "dev:developers": "astro dev --root developers --port 4322 --host 127.0.0.1",
    "build:users": "astro build --root users",
    "build:developers": "astro build --root developers",
    "build": "npm run build:users && npm run build:developers",
    "preview:users": "astro preview --root users --port 4321 --host 127.0.0.1",
    "preview:developers": "astro preview --root developers --port 4322 --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.4.4",
    "@astrojs/starlight": "0.42.0",
    "@astrojs/markdown-remark": "7.3.0"
  }
}
