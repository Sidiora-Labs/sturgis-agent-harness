{
  "name": "sturgis-consumer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:web": "npm run build:web && node scripts/verify_web.mjs",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck:web": "tsc -p frontend/tsconfig.json",
    "lint": "npm run lint:web && npm run typecheck:web",
    "lint:web": "eslint --config eslint.config.mjs . --max-warnings=0",
    "typecheck": "npm run typecheck:web",
    "format:check": "make format-check",
    "test:components": "vitest run --config frontend/vitest.config.ts",
    "build": "npm run build:web",
    "dev": "npm run dev:web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
