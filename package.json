    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "ast-v8-to-istanbul": "1.0.6",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.47.0",
    "motion": "13.2.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
