# Development-only examples. The application does not automatically load .env.
# Export selected values in your shell, or use an explicit environment-file loader.
# Do not commit provider API keys, bootstrap tokens, or account credentials.
STURGIS_MODE=self_hosted
STURGIS_HOST=127.0.0.1
STURGIS_PORT=8787
STURGIS_PUBLIC_ORIGIN=http://127.0.0.1:8787
STURGIS_ALLOW_SIGNUP=false

# The CLI defaults to ~/.local/share/sturgis; make dev uses ignored .data/sturgis.
# Override the root for a separate disposable development installation:
# STURGIS_ROOT=/absolute/path/to/sturgis-development-data

# The source checkout defaults to .build/native/sturgis-memory after make build.
# STURGIS_NATIVE_BINARY=/absolute/path/to/sturgis-memory

# Optional exact origins for intentionally connected local model servers.
# STURGIS_PRIVATE_NETWORK_ORIGINS=http://127.0.0.1:11434

# Do not set STURGIS_BOOTSTRAP_TOKEN in a shared file. Let setup generate it and
# keep the installation token file private. Connect provider credentials through
# Model Gateway rather than placing them in repository configuration.
